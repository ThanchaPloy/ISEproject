# PocketBase URL (internal URL used by backend)
PB_URL=http://pocketbase:8090

# PocketBase Admin (service account) credentials (used by backend to run admin tasks)
PB_ADMIN_EMAIL=ops@example.com
PB_ADMIN_PASS=ChangeMeInProd

# Backend runtime port
PORT=3000

# Optional: JWT secret for backend-issued tokens (if you use)
JWT_SECRET=replace_with_secure_value

# Optional SMTP (if backend sends email via provider/API; PocketBase mail is set in PB Admin UI)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="App Learn <no-reply@example.com>"